
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #20251f;
  background: #faf9f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
  scroll-behavior: smooth;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 3px solid #9aab85;
  outline-offset: 3px;
}

.navbar {
  height: 78px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid #e8e7df;
  background: #faf9f6;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -1px;
}

.brand-icon {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  background: #293d2d;
  color: #fff;
  border-radius: 8px 8px 8px 2px;
  font-family: 'Playfair Display', serif;
  font-size: 22px;
}

.brand-ai {
  color: #72855e;
  margin-left: -6px;
}

.nav-links {
  display: flex;
  gap: 32px;
  color: #64685e;
  font-size: 13px;
}

.nav-links a:hover {
  color: #293d2d;
}

.nav-button {
  border: 1px solid #d8d9ce;
  border-radius: 7px;
  padding: 11px 15px;
  font-size: 12px;
  font-weight: 600;
}

.nav-button span {
  margin-left: 10px;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 590px;
  padding: 85px 10% 76px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 55px;
  background: #f1f0e8;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.eyebrow,
.section-label {
  color: #78856b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #829b69;
  box-shadow: 0 0 0 4px #dfe5d5;
}

.hero h1 {
  margin: 25px 0 18px;
  font-family: 'Playfair Display', serif;
  font-size: clamp(44px, 5vw, 69px);
  font-weight: 500;
  letter-spacing: -3px;
  line-height: 1.06;
}

.hero h1 span {
  color: #77876a;
  font-style: italic;
}

.hero-description {
  max-width: 430px;
  color: #686c61;
  font-size: 14px;
  line-height: 1.9;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  margin-top: 30px;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  padding: 15px 20px;
  border: 0;
  border-radius: 6px;
  background: #293d2d;
  color: white;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

.primary-button:hover {
  background: #405a42;
  transform: translateY(-2px);
}

.secondary-button {
  color: #4f574a;
  font-size: 12px;
  font-weight: 600;
}

.hero-note {
  margin-top: 36px;
  color: #77796f;
  font-size: 11px;
}

.hero-note span {
  color: #7f916a;
  margin-right: 6px;
}

.newspaper-preview {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 385px;
  justify-self: center;
  padding: 23px 24px 18px;
  background: #fffefa;
  border: 1px solid #e5e3d9;
  box-shadow: 14px 20px 45px #2c382512;
  transform: rotate(2deg);
}

.paper-top,
.paper-meta,
.paper-footer {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: #7e8076;
  font-size: 7px;
  letter-spacing: 1px;
}

.paper-masthead {
  margin-top: 20px;
  font-family: 'Playfair Display', serif;
  font-size: 47px;
  line-height: 1.03;
  letter-spacing: -2px;
}

.paper-masthead.accent {
  margin-top: 0;
  color: #78876a;
  font-style: italic;
}

.paper-rule {
  height: 1px;
  margin: 17px 0;
  background: #d9d9ce;
}

.paper-feature {
  display: grid;
  grid-template-columns: 1fr 75px;
  gap: 12px;
  align-items: center;
}

.paper-category,
.mini-category {
  color: #7c8c6d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.paper-feature h3 {
  margin: 10px 0 6px;
  font-family: 'Playfair Display', serif;
  font-size: 23px;
  line-height: 1.2;
}

.paper-feature p {
  color: #77796f;
  font-size: 9px;
  line-height: 1.6;
}

.paper-illustration {
  display: grid;
  place-items: center;
  height: 80px;
  background: #e9eddf;
  color: #81956e;
  font-size: 57px;
}

.paper-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.mini-line {
  height: 4px;
  margin-top: 8px;
  background: #e5e4dd;
}

.mini-line.wide {
  width: 100%;
}

.mini-line.short {
  width: 62%;
}

.paper-footer {
  margin-top: 25px;
  padding-top: 12px;
  border-top: 1px solid #e4e2d9;
}

.hero-decoration {
  position: absolute;
  width: 150px;
  height: 150px;
  border: 1px solid #dfe2d3;
  border-radius: 50%;
}

.decoration-one {
  top: -90px;
  right: 35%;
}

.decoration-two {
  bottom: -110px;
  left: 40%;
  width: 200px;
  height: 200px;
}

.stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 30px 12%;
  border-bottom: 1px solid #e8e7df;
  background: #fffefa;
}

.stats-strip > div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.stats-strip strong {
  font-family: 'Playfair Display', serif;
  font-size: 27px;
  font-weight: 500;
}

.stats-strip span {
  max-width: 110px;
  color: #77796f;
  font-size: 10px;
  line-height: 1.5;
}

.edition-section {
  padding: 90px 10%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 35px;
}

.section-heading h2,
.personalize-copy h2 {
  margin: 15px 0 10px;
  font-family: 'Playfair Display', serif;
  font-size: clamp(31px, 4vw, 44px);
  font-weight: 500;
  letter-spacing: -1.5px;
}

.section-heading p,
.personalize-copy > p {
  color: #74766d;
  font-size: 12px;
  line-height: 1.8;
}

.date-badge {
  flex-shrink: 0;
  padding: 9px 12px;
  border: 1px solid #e1e1d8;
  border-radius: 4px;
  color: #77796f;
  font-size: 9px;
  letter-spacing: 1px;
}

.story-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.story-card {
  overflow: hidden;
  border: 1px solid #e7e5dc;
  border-radius: 7px;
  background: #fffefa;
  transition: transform 0.2s, box-shadow 0.2s;
}

.story-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 25px #293d2d0c;
}

.story-art {
  height: 155px;
  padding: 18px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.story-number {
  font-size: 10px;
  letter-spacing: 1px;
}

.story-symbol {
  align-self: center;
  margin-right: 15px;
  font-size: 66px;
  font-family: 'Playfair Display', serif;
  color: #53664b;
}

.story-body {
  padding: 21px;
}

.story-category {
  color: #78886b;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.story-body h3 {
  margin: 13px 0;
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 500;
  line-height: 1.35;
}

.story-body p {
  color: #77796f;
  font-size: 11px;
  line-height: 1.8;
}

.read-time {
  display: block;
  margin-top: 20px;
  color: #929388;
  font-size: 9px;
}

.preview-note {
  margin-top: 18px;
  color: #85867b;
  font-size: 10px;
}

.personalize-section {
  padding: 80px 10%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 70px;
  background: #f0f0e8;
}

.personalize-copy > p {
  max-width: 390px;
  margin-bottom: 25px;
}

.benefit {
  margin-top: 16px;
  color: #5f6658;
  font-size: 11px;
}

.benefit span {
  display: inline-grid;
  place-items: center;
  width: 19px;
  height: 19px;
  margin-right: 8px;
  border-radius: 50%;
  background: #dfe6d6;
  color: #415c3e;
}

.interest-card {
  padding: 28px;
  border: 1px solid #e3e2d8;
  border-radius: 9px;
  background: #fffefa;
  box-shadow: 0 12px 35px #293d2d08;
}

.form-heading h3 {
  margin: 12px 0 7px;
  font-family: 'Playfair Display', serif;
  font-size: 27px;
  font-weight: 500;
}

.form-heading p {
  margin-bottom: 24px;
  color: #77796f;
  font-size: 11px;
  line-height: 1.7;
}

.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.topic-chip {
  padding: 10px 12px;
  border: 1px solid #e4e4db;
  border-radius: 5px;
  background: #fffefa;
  color: #5d6258;
  font-size: 10px;
  cursor: pointer;
}

.topic-chip.selected {
  border-color: #718466;
  background: #e8eddf;
  color: #30462f;
}

.email-label {
  display: block;
  margin: 24px 0 8px;
  color: #54594f;
  font-size: 10px;
  font-weight: 600;
}

.interest-card input {
  width: 100%;
  padding: 13px;
  border: 1px solid #e1e2d8;
  border-radius: 5px;
  background: #fffefa;
  color: #20251f;
  font-size: 12px;
}

.submit-button {
  width: 100%;
  margin-top: 15px;
}

.success-message {
  padding: 12px;
  border-radius: 5px;
  background: #e8eddf;
  color: #30462f;
  font-size: 11px;
  line-height: 1.7;
}

.footer {
  padding: 35px 10%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: #fffefa;
}

.footer-brand {
  font-size: 17px;
}

.footer-brand .brand-icon {
  width: 27px;
  height: 27px;
  font-size: 18px;
}

.footer p,
.footer > span {
  color: #7c7d73;
  font-size: 10px;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 65px 8%;
    gap: 45px;
  }

  .hero-content {
    max-width: 600px;
  }

  .newspaper-preview {
    width: min(100%, 385px);
  }

  .story-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .personalize-section {
    grid-template-columns: 1fr;
    gap: 35px;
  }
}

@media (max-width: 600px) {
  .navbar {
    height: 68px;
    padding: 0 5%;
  }

  .brand {
    font-size: 17px;
  }

  .nav-links {
    display: none;
  }

  .nav-button {
    padding: 10px;
    font-size: 10px;
  }

  .hero {
    padding: 58px 6%;
  }

  .hero h1 {
    font-size: 48px;
  }

  .hero-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .stats-strip {
    padding: 25px 5%;
    gap: 10px;
  }

  .stats-strip > div {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .stats-strip strong {
    font-size: 24px;
  }

  .edition-section,
  .personalize-section {
    padding: 60px 6%;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .story-grid {
    grid-template-columns: 1fr;
  }

  .story-art {
    height: 130px;
  }

  .interest-card {
    padding: 20px;
  }

  .footer {
    padding: 30px 6%;
    flex-direction: column;
    align-items: flex-start;
  }
}
